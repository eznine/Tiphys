{
  "name": "tiphys",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "node scripts/dev.mjs",
    "bundle:sidecars": "node scripts/bundle-sidecars.mjs",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop:dev": "node scripts/build-desktop.mjs --dev",
    "portable:zip": "node scripts/portable-zip.mjs",
    "android:build": "node scripts/build-android.mjs",
    "android:sync": "npx cap sync android",
    "test:agent": "npm --prefix agent test",
    "test:engine": "node scripts/test-engine.mjs",
    "test:browser": "npm run build && node --import ./agent/node_modules/tsx/dist/loader.mjs --test tests/browser-engine.test.ts tests/map-render.test.ts",
    "build": "tsc && vite build",
    "import:browser-engine": "node scripts/import-browser-engine.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "engine": "node scripts/engine.mjs",
    "engine:ping": "node -e \"fetch('http://127.0.0.1:8971/ping').then(r=>r.text()).then(console.log)\"",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml",
    "agent": "npm --prefix agent start",
    "agent:tools": "node scripts/agent-tools.mjs",
    "audit:catalog": "node --import ./agent/node_modules/tsx/dist/loader.mjs scripts/catalog-audit.ts",
    "baseline": "node --import ./agent/node_modules/tsx/dist/loader.mjs scripts/run-baseline.ts",
    "test:contracts": "node --import ./agent/node_modules/tsx/dist/loader.mjs --test tests/contracts.test.ts",
    "test:methods": "node --import ./agent/node_modules/tsx/dist/loader.mjs --test tests/methods.test.ts",
    "test:search": "node --import ./agent/node_modules/tsx/dist/loader.mjs --test tests/search-quality.test.ts",
    "test:plans": "node --import ./agent/node_modules/tsx/dist/loader.mjs --test tests/plans.test.ts tests/task-cards.test.ts tests/budget.test.ts",
    "baseline:plans": "node --import ./agent/node_modules/tsx/dist/loader.mjs scripts/run-plan-baseline.ts",
    "baseline:agent": "node --import ./agent/node_modules/tsx/dist/loader.mjs scripts/run-agent-baseline.ts",
    "baseline:mobile": "node --import ./agent/node_modules/tsx/dist/loader.mjs scripts/run-mobile-baseline.ts",
    "vertical:hydro": "node --import ./agent/node_modules/tsx/dist/loader.mjs scripts/run-hydrology-vertical.ts",
    "vertical:gis": "node --import ./agent/node_modules/tsx/dist/loader.mjs scripts/run-gis-vertical.ts",
    "vertical:ecology": "node --import ./agent/node_modules/tsx/dist/loader.mjs scripts/run-ecology-vertical.ts",
    "fixtures:ecology": "engine/.venv/bin/python scripts/make-ecology-fixtures.py",
    "bench:geoagent": "node --import ./agent/node_modules/tsx/dist/loader.mjs scripts/run-geoagentbench.ts",
    "compare:arms": "node --import ./agent/node_modules/tsx/dist/loader.mjs scripts/compare-agent-arms.ts",
    "compare:engines": "node --import ./agent/node_modules/tsx/dist/loader.mjs scripts/compare-engines.ts",
    "wasm:spike": "node --import ./agent/node_modules/tsx/dist/loader.mjs scripts/wasm-spike.ts",
    "eval:search": "node --import ./agent/node_modules/tsx/dist/loader.mjs scripts/search-eval.ts",
    "fixtures": "engine/.venv/Scripts/python.exe scripts/make-test-fixtures.py",
    "catalog:engine": "engine/.venv/Scripts/python.exe scripts/export_engine_catalog.py",
    "deploy:xyz": "node scripts/run-deploy-xyz.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.87",
    "@capacitor/android": "^6.2.2",
    "@capacitor/core": "^6.2.2",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "ai": "^6.0.312",
    "fflate": "^0.8.3",
    "geolibre-wasm": "^1.7.1",
    "idb": "^8.0.3",
    "lucide-react": "^1.61.0",
    "maplibre-gl": "^6.15.0",
    "proj4": "^2.22.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.2",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.5",
    "playwright": "^1.64.1",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
