      "type": "object"
    },
    "category": "数据管理",
    "annotations": {
      "readOnlyHint": true
    }
  },
  {
    "name": "buffer",
    "description": "Buffer a layer (GeoLibre WASM). Returns a job_id immediately; poll job_status / job_cancel.\n\nParameter shape follows RustGIS analysis buffer (input/distance/units/dissolve/output)\nand GeoLibre unit names (meters|kilometers|miles). Implementation is GeoLibre WASM.\n\nArgs:\n    layer: Source layer id or name.\n    distance: Buffer distance.\n    units: meters (default), kilometers, or miles.\n    dissolve: Merge all buffers into one polygon.\n    output_name: Optional output layer name.\n",
    "parameters": {
      "properties": {
        "layer": {
          "title": "Layer",
          "type": "string"
        },
        "distance": {
          "title": "Distance",
          "type": "number"
        },
        "units": {
          "default": "meters",
          "enum": [
            "meters",
            "kilometers",
            "miles"
          ],
          "title": "Units",
          "type": "string"
        },
        "dissolve": {
          "default": false,
          "title": "Dissolve",
          "type": "boolean"
        },
        "output_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Name"
        }
      },
      "required": [
        "layer",
        "distance"
      ],
      "title": "bufferArguments",
      "type": "object"
    },
    "category": "邻近分析",
    "annotations": {}
  },
