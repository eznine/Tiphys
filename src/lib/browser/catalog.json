  {
    "name": "select_by_attributes",
    "description": "Select features by an attribute condition into a new layer. Structured ops only (no free-form expressions).\n\nOps: eq, ne, gt, ge, lt, le, contains, startswith, endswith, isnull, notnull.\n\nArgs:\n    layer: Layer id or name.\n    field: Column name.\n    op: Comparison operator from the list above.\n    value: Comparison value (ignored for isnull/notnull).\n    output_name: Optional output layer name.\n",
    "parameters": {
      "properties": {
        "layer": {
          "title": "Layer",
          "type": "string"
        },
        "field": {
          "title": "Field",
          "type": "string"
        },
        "op": {
          "enum": [
            "eq",
            "ne",
            "gt",
            "ge",
            "lt",
            "le",
            "contains",
            "startswith",
            "endswith",
            "isnull",
            "notnull"
          ],
          "title": "Op",
          "type": "string"
        },
        "value": {
          "default": "",
          "title": "Value",
          "type": "string"
        },
        "output_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Name"
        }
      },
      "required": [
        "layer",
        "field",
        "op"
      ],
      "title": "select_by_attributesArguments",
      "type": "object"
    },
    "category": "查询与选择",
    "annotations": {}
  },
