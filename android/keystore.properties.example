# Copy to one of:
#   F:\tooling\signing\keystore.properties   (Windows canonical)
#   ~/.config/tiphys/signing/keystore.properties
#   <repo>/.signing/keystore.properties      (gitignored)
# Place tiphys-canonical.keystore next to this file (or set absolute storeFile).
# NEVER commit the real keystore or this file with real passwords if you change them.
storeFile=tiphys-canonical.keystore
storePassword=android
keyAlias=androiddebugkey
keyPassword=android
