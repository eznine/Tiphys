        { "tool": "buffer", "args": { "layer": "@bad", "distance": 300, "units": "meters" }, "capture": "buf", "allow_error": true }
      ],
      "checks": [
        { "type": "either", "note": "要么修复后产出有效结果，要么给出明确的无效几何错误；静默返回空/错误几何均记 FAIL",
          "checks": [
            { "type": "feature_count", "of": "buf", "op": "gte", "value": 1 },
            { "type": "error_pattern", "of": "buf", "pattern": "几何|无效|invalid|self" }
          ] }
      ]
